{
  "description" : "Sends a request to an LLM model",
  "input" : {
    "type" : "object",
    "properties" : {
      "llmModelKey" : {
        "type" : "string",
        "description" : "The key identifying which LLM model to use"
      },
      "messages" : {
        "type" : "array",
        "description" : "Conversation sent to the model, oldest message first",
        "items" : {
          "type" : "object",
          "description" : "",
          "properties" : {
            "role" : {
              "type" : "string",
              "description" : "Message role: assistant, user, system, or tool"
            },
            "text" : {
              "type" : "string",
              "description" : "Message text"
            },
            "images" : {
              "type" : "array",
              "description" : "Images attached to the message",
              "items" : {
                "type" : "object",
                "description" : "",
                "properties" : {
                  "url" : {
                    "type" : "string",
                    "description" : "Image URL"
                  },
                  "description" : {
                    "type" : "string",
                    "description" : "What to pay attention to in the image"
                  },
                  "mimeType" : {
                    "type" : "string",
                    "description" : "Image mime type, needed by Gemini only"
                  }
                },
                "required" : [ "url" ]
              }
            },
            "toolCalls" : {
              "type" : "array",
              "description" : "Tool calls the model asked for in its previous reply. Fill in only when you continue a tool-calling loop: return them together with that assistant message. Leave empty for a plain request",
              "items" : {
                "type" : "object",
                "description" : "",
                "properties" : {
                  "id" : {
                    "type" : "string",
                    "description" : "Tool call identifier from the model reply"
                  },
                  "name" : {
                    "type" : "string",
                    "description" : "Name of the tool the model asked to call"
                  },
                  "arguments" : {
                    "type" : "object",
                    "description" : "Tool arguments as JSON object",
                    "properties" : { },
                    "required" : [ ]
                  }
                },
                "required" : [ ]
              }
            },
            "toolCallId" : {
              "type" : "string",
              "description" : "Identifier of the tool call this message answers. Filled in for messages with role tool"
            }
          },
          "required" : [ "role" ]
        }
      },
      "tools" : {
        "type" : "array",
        "description" : "Tools you offer the model. Needed only for a manual tool-calling loop: instead of text the model may answer with tool calls, and the scenario runs the tool itself and sends the result back with role tool. Leave empty for a plain request",
        "items" : {
          "type" : "object",
          "description" : "",
          "properties" : {
            "name" : {
              "type" : "string",
              "description" : "Tool name the model refers to"
            },
            "description" : {
              "type" : "string",
              "description" : "What the tool does — the model chooses the tool by this text"
            },
            "parameters" : {
              "type" : "object",
              "description" : "Tool parameters as JSON Schema",
              "properties" : { },
              "required" : [ ]
            }
          },
          "required" : [ "name" ]
        }
      },
      "maxCompletionTokens" : {
        "type" : "integer",
        "description" : "Maximum number of tokens to generate in the completion"
      },
      "temperature" : {
        "type" : "number",
        "description" : "Sampling temperature (0-2.0), lower is more deterministic"
      },
      "topP" : {
        "type" : "number",
        "description" : "Nucleus sampling parameter (0-1.0)"
      },
      "responseFormat" : {
        "type" : "object",
        "description" : "Optional. JSON Schema of a structured answer. Without it the model answers with plain text in the text field",
        "properties" : { },
        "required" : [ ]
      },
      "chatId" : {
        "type" : "string",
        "description" : "Optional chat identifier"
      }
    },
    "required" : [ "llmModelKey", "messages" ]
  },
  "output" : {
    "type" : "object",
    "description" : "LLM response",
    "properties" : {
      "text" : {
        "type" : "string",
        "description" : "Generated text response"
      },
      "toolCalls" : {
        "type" : "array",
        "description" : "Tool calls made by the LLM",
        "items" : {
          "type" : "object",
          "properties" : {
            "id" : {
              "type" : "string",
              "description" : "Tool call identifier"
            },
            "name" : {
              "type" : "string",
              "description" : "Tool name"
            },
            "arguments" : {
              "type" : "object",
              "description" : "Tool arguments as JSON object",
              "properties" : { }
            }
          },
          "required" : [ "id", "name" ]
        }
      },
      "usage" : {
        "type" : "object",
        "description" : "Token usage statistics",
        "properties" : {
          "inputTokens" : {
            "type" : "integer",
            "description" : "Number of input tokens used"
          },
          "outputTokens" : {
            "type" : "integer",
            "description" : "Number of output tokens generated"
          },
          "totalTokens" : {
            "type" : "integer",
            "description" : "Total tokens used"
          }
        },
        "required" : [ "inputTokens", "outputTokens", "totalTokens" ]
      }
    },
    "required" : [ "usage" ]
  }
}